@model IEnumerable<Core.DTO.AdministradorGrupoMusicalDTO>

<div class="table-responsive">
    <table class="table">
        <thead class="bg-danger bg-opacity-75 text-white">
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Nome)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Cpf)
                </th>
                <th>
                    Ações
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr class="border-bottom border-danger border-opacity-75">
                    <td class="py-3">
                        @Html.DisplayFor(modelItem => item.Nome)
                    </td>
                    <td class="py-3">
                        @Html.DisplayFor(modelItem => item.Cpf)
                    </td>
                    <td class="py-3 border-0 d-flex flex-column flex-lg-row gap-3">

                        <!-- BOTÃO NOTIFICAR (Passa o ID usando data-id) -->
                        <button type="button" class="btn btn-sm btn-secondary" data-bs-toggle="modal" data-bs-target="#admModalNotificar" data-id="@item.Id">
                            <i class="fa-solid fa-envelope"></i> Notificar
                        </button>

                        <!-- BOTÃO EXCLUIR (Passa o ID usando data-id) -->
                        <button type="button" class="btn btn-sm btn-secondary" data-bs-toggle="modal" data-bs-target="#admModalExcluir" data-id="@item.Id">
                            <i class="fa-solid fa-xmark"> </i> Excluir
                        </button>

                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Modal de Excluir -->
<div class="modal fade" id="admModalExcluir" tabindex="-1" aria-labelledby="admLabelExcluir" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="admLabelExcluir">Confirmar Remoção de Cargo de Administrador</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Deseja <b>Remover</b> o cargo de <b>Administrador</b>?
            </div>
            <!-- FORMULÁRIO DE EXCLUSÃO CORRIGIDO -->
            <form method="post" asp-controller="AdministradorGrupoMusical" asp-action="Delete" class="modal-footer">
                <input type="hidden" name="id" id="inputExcluirId" value="" />
                <button type="button" class="btn btn-outline-secondary col-3 me-4" data-bs-dismiss="modal">Não</button>
                <button type="submit" class="btn btn-secondary col-3">Sim</button>
            </form>
        </div>
    </div>
</div>

<!-- Modal de Notificar -->
<div class="modal fade" id="admModalNotificar" tabindex="-1" aria-labelledby="admLabelNotificar" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="admLabelNotificar">Confirmar Notificação de Cargo de Administrador</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Deseja <b>Notificar</b> o cargo de <b>Administrador</b>?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary col-3 me-4" data-bs-dismiss="modal">Não</button>
                <!-- O controller Notificar é GET, então usamos um link <a> no lugar de um formulário POST -->
                <a id="btnConfirmarNotificar" href="#" class="btn btn-secondary col-3">Sim</a>
            </div>
        </div>
    </div>
</div>

<!-- SCRIPT QUE PASSA OS IDs CORRETOS DA TABELA PARA OS MODAIS -->
<script>
    document.addEventListener("DOMContentLoaded", function () {

        // Configura o modal de Exclusão
        var modalExcluir = document.getElementById('admModalExcluir');
        modalExcluir.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var id = button.getAttribute('data-id'); // Pega o ID que clicamos
            document.getElementById('inputExcluirId').value = id; // Joga no formulário
        });

        // Configura o modal de Notificação
        var modalNotificar = document.getElementById('admModalNotificar');
        modalNotificar.addEventListener('show.bs.modal', function (event) {
        var button = event.relatedTarget;
        var id = button.getAttribute('data-id');
        document.getElementById('btnConfirmarNotificar').href = '@Url.Action("NotificarEmail", "AdministradorGrupoMusical")/' + id;
    });

    });
</script>