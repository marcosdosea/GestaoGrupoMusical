@model IEnumerable<Core.DTO.FinanceiroIndexDataPage>

<link href="~/lib/datatable/css/dataTables.min.css" rel="stylesheet" />

@{
    ViewData["Title"] = "Pagamentos";
}

<!-- FECHAMENTO CORRETO DA PARTIAL -->
<partial name="_Notificar" />

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
    <h5>@ViewData["Title"]</h5>
    <a role="button" class="btn btn-secondary m-3" asp-controller="Financeiro" asp-action="Create">
        Novo Pagamento
    </a>
</div>

<div class="table-responsive">
    <table id="tableFinanceiro" class="table table-striped table-bordered dt-responsive">
        <thead>
            <tr class="bg-danger bg-opacity-75 text-white">
                <th class="px-3">@Html.DisplayNameFor(model => model.Descricao)</th>
                <th class="px-3">@Html.DisplayNameFor(model => model.DataInicio)</th>
                <th class="px-3">@Html.DisplayNameFor(model => model.DataFim)</th>
                <th class="px-3">@Html.DisplayNameFor(model => model.Pagos)</th>
                <th class="px-3">@Html.DisplayNameFor(model => model.Isentos)</th>
                <th class="px-3">@Html.DisplayNameFor(model => model.Atrasos)</th>
                <th class="px-3">@Html.DisplayNameFor(model => model.Recebido)</th>
                <th class="px-3"><span>Ações</span></th>
            </tr>
        </thead>
    </table>
</div> <!-- DESCOMENTADO O FECHAMENTO DA DIV -->
<!-- INÍCIO DOS MODAIS (AGORA FORA DA TABLE-RESPONSIVE) -->
<div class="modal fade" id="financeiroModalDelete" tabindex="-1" aria-labelledby="financeiroLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="admLabel1">Confirmar Exclusão do pagamento</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body1 p-3">
                Deseja <b>Excluir</b> o <b>pagamento</b>?
            </div>
            <form method="post" class="modal-footer">
                <button type="button" class="btn btn-outline-secondary col-3 me-4" data-bs-dismiss="modal">Não</button>
                <button type="submit" class="btn btn-secondary col-3">Sim</button>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="financeiroModalNotificar" tabindex="-1" aria-labelledby="financeiroLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="admLabel2">Confirmar Notificação do pagamento?</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body2 p-3">
                Deseja <b>Notificar</b> o <b>Pagamento</b>?
            </div>
            <form method="post" class="modal-footer">
                <button type="button" class="btn btn-outline-secondary col-3 me-4" data-bs-dismiss="modal">Não</button>
                <button type="submit" class="btn btn-secondary col-3">Sim</button>
            </form>
        </div>
    </div>
</div>
<!-- FIM DOS MODAIS -->
@section Scripts {
    <script src="~/lib/datatable/js/dataTables.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#tableFinanceiro').DataTable({
                "processing": true,
                "serverSide": true,
                "filter": true,
                "orderMulti": false,
                "pageLength": 5,
                "lengthMenu": [
                    [5, 10, 20],
                    [5, 10, 20]
                ],
                "responsive": true,
                "scrollX": true,
                "ajax": {
                    "url": "/Financeiro/GetDataPage",
                    "type": "POST",
                    "datatype": "json"
                },
                "columnDefs": [
                    { "targets": [0], "visible": true, "searchable": false },
                    { "targets": [3], "visible": true, "searchable": false, "orderable": false }
                ],
                "order": [[1, 'desc'], [2, 'desc'], [0, 'asc']],
                // Inicializa os tooltips após desenhar a tabela
                "drawCallback": function(settings) {
                    var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
                    tooltipTriggerList.map(function (tooltipTriggerEl) {
                        return new bootstrap.Tooltip(tooltipTriggerEl);
                    });
                },
                "columns": [
                    { "data": "descricao", "autoWidth": true },
                    {
                        "data": "dataInicio",
                        "name": "Inicio",
                        "autoWidth": true,
                        "render": function (data) {
                            if (!data) return ""; // Trata data nula
                            var date = new Date(data);
                            return String(date.getDate()).padStart(2, '0') + '/' +
                                   String(date.getMonth() + 1).padStart(2, '0') + '/' +
                                   date.getFullYear();
                        }
                    },
                    {
                        "data": "dataFim",
                        "autoWidth": true,
                        "render": function (data) {
                            if (!data) return ""; // Trata data nula
                            var date = new Date(data);
                            return String(date.getDate()).padStart(2, '0') + '/' +
                                   String(date.getMonth() + 1).padStart(2, '0') + '/' +
                                   date.getFullYear();
                        }
                    },
                    { "data": "pagos", "autoWidth": true },
                    { "data": "isentos", "autoWidth": true },
                    { "data": "atrasos", "autoWidth": true },
                    {
                        "data": "recebido",
                        "autoWidth": true,
                        "render": function (data) {
                            if (!isNaN(data) && data !== null) {
                                return parseFloat(data).toFixed(2).replace('.', ',');
                            }
                            return data;
                        }
                    },
                    {
                        "render": function (data, type, full, meta) {
                            return `
                                <div class="d-flex flex-wrap gap-1 justify-content-center">
                                    <a class="btn btn-secondary btn-sm" href="/Financeiro/Edit/${full.id}" data-bs-toggle="tooltip" title="Editar">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </a>
                                    <a class="btn btn-secondary btn-sm" href="/Financeiro/Details/${full.id}" data-bs-toggle="tooltip" title="Detalhes">
                                        <i class="fa-solid fa-circle-info"></i>
                                    </a>
                                    <a class="btn btn-secondary btn-sm" href="/Financeiro/Pag_Associados/${full.id}" data-bs-toggle="tooltip" title="Pag. Associados">
                                        <i class="fa-solid fa-users"></i>
                                    </a>
                                    <a onclick="showConfirmationModalDelete(${full.id})" class="btn btn-secondary btn-sm" role="button" data-bs-toggle="tooltip" title="Excluir">
                                        <i class="fa-solid fa-xmark"></i>
                                    </a>
                                    <a onclick="showConfirmationModalNotificar(${full.id})" class="btn btn-secondary btn-sm" role="button" data-bs-toggle="tooltip" title="Notificar">
                                        <i class="fa-solid fa-envelope"></i>
                                    </a>
                                </div>
                            `;
                        }
                    }
                ],
                "language": {
                    "url": "lib/datatable/js/pt-BR.json",
                }
            });
        });

        // Nomenclatura das variáveis do modal corrigida (modalEl vs modalInstance)
        function showConfirmationModalDelete(formId) {
            var modalEl = document.getElementById('financeiroModalDelete');
            var modalForm = modalEl.querySelector('form');
            modalForm.action = '/Financeiro/Delete/' + formId;

            var modalBody = modalEl.querySelector('.modal-body1');
            modalBody.innerHTML = 'Deseja <b>Excluir</b> o <b>Pagamento</b>?';

            var modalInstance = new bootstrap.Modal(modalEl);
            modalInstance.show();
        }

        // Nomenclatura das variáveis do modal corrigida
        function showConfirmationModalNotificar(formId) {
            var modalEl = document.getElementById('financeiroModalNotificar');
            var modalForm = modalEl.querySelector('form');
            modalForm.action = '/Financeiro/NotificarFinanceiroViaEmail/' + formId;

            var modalBody = modalEl.querySelector('.modal-body2');
            modalBody.innerHTML = 'Deseja <b>Notificar</b> o <b>Pagamento</b> para todos os associados?';

            var modalInstance = new bootstrap.Modal(modalEl);
            modalInstance.show();
        }
    </script>
}