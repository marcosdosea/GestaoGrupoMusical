@using Core.Service
@model GestaoGrupoMusicalWeb.Models.PagamentoAssociadoViewModel

@{
    ViewData["Title"] = "Pagamentos dos Associados";

    // A lista de seleção para o dropdown de status
    var statusList = new List<SelectListItem>
    {
        new SelectListItem { Value = "ABERTO", Text = "Aberto" },
        new SelectListItem { Value = "ENVIADO", Text = "Enviado" },
        new SelectListItem { Value = "PAGO", Text = "Pago" },
        new SelectListItem { Value = "ISENTO", Text = "Isento" }
    };
}

<partial name="_Notificar" />

<div class="card">
    <div class="card-header bg-danger bg-opacity-75 text-white">
        <h5 class="card-title mb-0">@ViewData["Title"]</h5>
    </div>
    <div class="card-body">
        @if (Model.Financeiro != null)
        {
            <div class="row mb-3 p-2" style="background-color: #f8f9fa; border-radius: 5px; border: 1px solid #dee2e6;">
                <div class="col-md-6">
                    <strong>Descrição do Pagamento:</strong> @Model.Financeiro.Descricao
                </div>
                <div class="col-md-3">
                    <strong>Data Início:</strong> @Model.Financeiro.DataInicio
                </div>
                <div class="col-md-3">
                    <strong>Data Vencimento:</strong> @Model.Financeiro.DataFim
                </div>
            </div>
        }

        <form asp-action="Pag_Associados">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="IdReceita" />

            <div class="table-responsive">
<<<<<<< HEAD
                <table class="table table-striped table-hover table-bordered">
                    <thead>
                        <tr class="bg-danger bg-opacity-75 text-white">
                            <th class="px-3">Associado</th>
                            <th class="px-3">CPF</th>
                            <th class="px-3" style="width: 170px;">Data Pagamento</th>
                            <th class="px-3" style="width: 160px;">Valor Pago (R$)</th>
                            <th class="px-3" style="min-width: 180px;">Observações</th>
                            <th class="px-3" style="width: 260px;">
                                <div class="d-flex align-items-center justify-content-center gap-2">
                                    <span>Status</span>
                                    <div class="dropdown">
                                        <span role="button" tabindex="0" class="text-white" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" title="Filtrar por status">
                                            <i class="fa-solid fa-filter"></i>
                                        </span>
                                        <ul class="dropdown-menu p-2 text-dark">
                                            <li>
                                                <label class="dropdown-item d-flex align-items-center gap-2 m-0">
                                                    <input type="checkbox" id="filtroTodos" class="form-check-input m-0" checked />
                                                    Todos
                                                </label>
                                            </li>
                                            <li><hr class="dropdown-divider" /></li>
                                            @foreach (var opcao in statusList)
                                            {
                                                <li>
                                                    <label class="dropdown-item d-flex align-items-center gap-2 m-0">
                                                        <input type="checkbox" class="form-check-input m-0 filtro-status" value="@opcao.Value" checked />
                                                        @opcao.Text
                                                    </label>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </div>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Associados != null && Model.Associados.Any())
                        {
                            for (int i = 0; i < Model.Associados.Count; i++)
                            {
                                // PAGO_COMPROVANTE é exibido como Pago e NAO_PAGOU como Aberto
                                var statusExibido = Model.Associados[i].Status switch
                                {
                                    "PAGO_COMPROVANTE" => "PAGO",
                                    "NAO_PAGOU" => "ABERTO",
                                    var status => status
                                };

                                <tr class="align-middle" data-status="@statusExibido">
                                    <td>
                                        @Model.Associados[i].NomeAssociado
                                        <input type="hidden" asp-for="Associados[i].IdAssociado" />
                                        <input type="hidden" asp-for="Associados[i].NomeAssociado" />
                                        <input type="hidden" asp-for="Associados[i].Cpf" />
                                    </td>
                                    <td class="text-nowrap">
                                        @Model.Associados[i].Cpf
                                    </td>
                                    <td>
                                        @{
                                            var dataValue = Model.Associados[i].DataPagamento?.ToString("yyyy-MM-dd") ?? "";
                                        }
                                        <input type="date" name="Associados[@i].DataPagamento" value="@dataValue" class="form-control" />
                                    </td>
                                    <td>
                                        <input type="number" step="0.01" asp-for="Associados[i].ValorPago" class="form-control" placeholder="0,00" />
                                    </td>
                                    <td>
                                        <textarea asp-for="Associados[i].Observacoes" class="form-control" rows="1"></textarea>
                                    </td>
                                    <td>
                                        <select asp-for="Associados[i].Status" asp-items="@(new SelectList(statusList, "Value", "Text", statusExibido))" class="form-select"></select>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center">Nenhum associado ativo encontrado.</td>
                            </tr>
                        }
                        <tr id="semResultadoStatus" hidden>
                            <td colspan="6" class="text-center">Nenhum associado encontrado para a situação selecionada.</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="row d-flex flex-column-reverse gap-2 mx-auto flex-xl-row mt-4">

                <div class="col-xl-8 d-none d-xl-block"></div>

                <div class="col-xl d-grid">
                    <a class="btn btn-light text-secondary border border-secondary" asp-action="Index">Cancelar</a>
                </div>

                <div class="col-xl d-grid">
                    <button type="submit" class="btn btn-secondary d-grid gap-2 col-sm">Salvar</button>
                </div>

            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // Filtra as linhas por status apenas ocultando-as: nenhuma linha sai do DOM, então o formulário continua enviando todos os associados
        document.getElementById('filtroTodos').addEventListener('change', function () {
            var marcado = this.checked;
            document.querySelectorAll('.filtro-status').forEach(function (c) { c.checked = marcado; });
            aplicarFiltroStatus();
        });

        document.querySelectorAll('.filtro-status').forEach(function (checkbox) {
            checkbox.addEventListener('change', function () {
                var todos = Array.from(document.querySelectorAll('.filtro-status'));
                document.getElementById('filtroTodos').checked = todos.every(function (c) { return c.checked; });
                aplicarFiltroStatus();
            });
        });

        function aplicarFiltroStatus() {
            var marcados = Array.from(document.querySelectorAll('.filtro-status:checked')).map(function (c) { return c.value; });
            var linhas = document.querySelectorAll('tbody tr[data-status]');

            linhas.forEach(function (tr) {
                tr.hidden = !marcados.includes(tr.dataset.status);
            });

            var todasOcultas = Array.from(linhas).every(function (tr) { return tr.hidden; });
            document.getElementById('semResultadoStatus').hidden = !todasOcultas;
        }
    </script>
}