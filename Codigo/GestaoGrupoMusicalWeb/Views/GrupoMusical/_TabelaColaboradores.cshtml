@model IEnumerable<Core.DTO.ColaboradoresDTO>

@{
    var papeis = (SelectList)ViewData["ListaPapeisAlteracao"];
}

@* Linhas do tbody da tabela de associados em IndexAdmGrupo *@
@foreach (var item in Model)
{
    <tr class="border-bottom border-danger border-opacity-75 p-3 align-middle">
        <td class="p-3">
            @Html.DisplayFor(modelItem => item.Cpf)
        </td>
        <td class="p-3">
            @Html.DisplayFor(modelItem => item.Nome)
        </td>
        <td class="p-3">
            @Html.DisplayFor(modelItem => item.Data)
        </td>
        <td class="p-3">
            @Html.DisplayFor(modelItem => item.Papel)
        </td>
        <td class="p-3">
            <form asp-action="Create" asp-controller="Colaborador" method="post" class="d-flex flex-wrap align-items-center gap-2">
                <input type="hidden" name="Id" value="@item.Id" />
                <select name="IdPapelGrupo" class="form-select form-select-sm w-auto" aria-label="Papel">
                    @foreach (var papel in papeis)
                    {
                        <option value="@papel.Value" selected="@(papel.Value == item.IdPapelGrupo.ToString())">@papel.Text</option>
                    }
                </select>
                <button type="submit" class="btn btn-sm btn-secondary">
                    <i class="fa-solid fa-user-pen"></i>
                    Alterar papel
                </button>
            </form>
        </td>
    </tr>
}
