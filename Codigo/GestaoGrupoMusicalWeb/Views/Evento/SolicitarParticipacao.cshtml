@model Core.DTO.EventoDetalhesAssociadoDTO
@using Core.DTO

@{
    ViewData["Title"] = "Solicitar Participação no Evento";
    Layout = "_LayoutAssociado";
}

<partial name="_Notificar" />

<div class="container">
    <h1 class="fs-5 mb-2">@ViewData["Title"]</h1>
    <hr />

    <div class="card shadow">
        <div class="card-header bg-danger bg-opacity-75 text-white">
            Detalhes do Evento
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Início</dt>
                <dd class="col-sm-9">@Model.DataHoraInicio.ToString("dd/MM/yyyy HH:mm")</dd>

                <dt class="col-sm-3">Fim</dt>
                <dd class="col-sm-9">@Model.DataHoraFim.ToString("dd/MM/yyyy HH:mm")</dd>

                @if (Model.DataHoraChegadaEvento.HasValue)
                {
                    <dt class="col-sm-3">Chegada</dt>
                    <dd class="col-sm-9">
                        <span class="fw-bold">@Model.DataHoraChegadaEvento.Value.ToString("dd/MM/yyyy HH:mm")</span>
                        @if (!string.IsNullOrWhiteSpace(Model.ObservacaoHoraChegada))
                        {
                            <div class="text-muted small" style="white-space: pre-line;">@Model.ObservacaoHoraChegada</div>
                        }
                    </dd>
                }
                else if (!string.IsNullOrWhiteSpace(Model.ObservacaoHoraChegada))
                {
                    <dt class="col-sm-3">Chegada</dt>
                    <dd class="col-sm-9 text-muted small" style="white-space: pre-line;">@Model.ObservacaoHoraChegada</dd>
                }

                <dt class="col-sm-3">Local</dt>
                <dd class="col-sm-9">@Model.Local</dd>

                <dt class="col-sm-3">Repertório</dt>
                <dd class="col-sm-9">@Model.Repertorio</dd>
            </dl>
        </div>
    </div>

    <hr />

    @* SEÇÃO 1: Se o usuário já estiver inscrito *@
    @if (Model.MinhaInscricao != null && Model.MinhaInscricao.StatusEnum != InscricaoEventoPessoa.NAO_SOLICITADO)
    {
        <div class="alert alert-info shadow-sm">
            <h4 class="alert-heading">Sua Situação</h4>
            <p class="mb-0">
                <strong>Status:</strong> @Model.MinhaInscricao.Status<br />
                @if (!string.IsNullOrEmpty(Model.MinhaInscricao.NomeInstrumento))
                {
                    <strong>Instrumento:</strong>
                    @Model.MinhaInscricao.NomeInstrumento
                }
            </p>
            @if (Model.MinhaInscricao.StatusEnum == InscricaoEventoPessoa.INSCRITO)
            {
                <hr />
                <p class="mb-0 small">
                    <i class="fa-solid fa-hourglass-half me-1" aria-hidden="true"></i>
                    Sua solicitação está <b>aguardando a aprovação</b> do administrador.
                </p>
            }
            else if (Model.MinhaInscricao.StatusEnum == InscricaoEventoPessoa.DEFERIDO)
            {
                <hr />
                <p class="mb-0 small">
                    <i class="fa-solid fa-circle-check me-1" aria-hidden="true"></i>
                    Sua participação está <b>confirmada</b>.
                </p>
            }
        </div>

        <div class="d-flex justify-content-end flex-wrap gap-2 mt-4">
            <a asp-controller="Ensaio" asp-action="EnsaiosAssociado" class="btn btn-secondary col-auto col-lg-1">Voltar</a>
            @if (Model.PodeCancelar)
            {
                <form asp-action="CancelarSolicitacao" method="post">
                    <input type="hidden" name="idEvento" value="@Model.Id" />
                    <button type="submit" class="btn btn-outline-secondary">Cancelar Solicitação</button>
                </form>
            }
        </div>
    }
    @* SEÇÃO 2: Se o usuário ainda pode se inscrever *@
    else if (Model.PodeInscrever)
    {
        <div class="card border-light shadow-sm">
            <div class="card-body">
                <h3 class="fs-5 mb-3">Escolha seu instrumento</h3>
                @if (Model.PrecisaConfirmarParticipacao)
                {
                    <div class="alert alert-warning d-flex align-items-start gap-2 py-2" role="note">
                        <i class="fa-solid fa-circle-info mt-1" aria-hidden="true"></i>
                        <span>Este evento precisa de <b>aprovação do administrador</b>. Sua participação será confirmada após a análise da solicitação.</span>
                    </div>
                }
                else
                {
                    <div class="alert alert-success d-flex align-items-start gap-2 py-2" role="note">
                        <i class="fa-solid fa-circle-check mt-1" aria-hidden="true"></i>
                        <span>Ao confirmar, sua participação já fica <b>garantida</b>, enquanto houver vagas para o instrumento.</span>
                    </div>
                }
                <form asp-action="ConfirmarSolicitacao" method="post">
                    <input type="hidden" name="IdEvento" value="@Model.Id" />

                    <div class="form-group mb-4">
                        <label for="IdTipoInstrumento" class="form-label">Instrumentos com vagas:</label>
                        <select name="IdTipoInstrumento" class="form-select" required>
                            <option value="">Selecione um instrumento...</option>
                            @foreach (var instrumento in Model.InstrumentosDisponiveis.Where(i => i.VagasDisponiveis > 0))
                            {
                                <option value="@instrumento.IdInstrumento">
                                    @instrumento.NomeInstrumento (@instrumento.VagasDisponiveis vagas)
                                </option>
                            }
                        </select>
                    </div>

                    <div class="d-flex justify-content-end flex-wrap gap-2">
                        <a asp-controller="Ensaio" asp-action="EnsaiosAssociado" class="btn btn-secondary col-auto col-lg-1">Voltar</a>
                        <button type="submit" class="btn btn-outline-secondary">Confirmar Inscrição</button>
                    </div>
                </form>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning shadow-sm">
            Não é mais possível se inscrever ou alterar sua inscrição para este evento.
        </div>
        <div class="d-flex justify-content-end">
            <a asp-controller="Ensaio" asp-action="EnsaiosAssociado" class="btn btn-secondary col-auto col-md-2">Voltar</a>
        </div>
    }
</div>